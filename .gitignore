###############################################################################
# .gitignore
#
# Based on the recommended GitHub template for Node.js
# (https://github.com/github/gitignore/blob/main/Node.gitignore), tailored to
# this repository's stack:
#
#   Next.js (App Router) · pnpm · TypeScript · Tailwind CSS · shadcn/ui
#   Playwright · ESLint · Prettier · Husky + commitlint · Vercel
#
# Layout:
#   1. Dependencies & package managers
#   2. Next.js & build output
#   3. Testing
#   4. Lint, format & type caches
#   5. Environment variables, secrets & certificates
#   6. Vercel
#   7. AI coding agents (per-tool local setups)  <-- agent-ready section
#   8. Editors & IDEs
#   9. Operating systems
#
# Upstream sections for frameworks/infra this repo does not use (Nuxt, Gatsby,
# SvelteKit, Astro, Docusaurus, vitepress, Vite, Serverless, DynamoDB Local,
# Firebase, FuseBox, Bower, Grunt, node-waf) were left out on purpose. Re-add
# the block from the upstream template if you ever adopt one of them.
#
# Files that LOOK ignorable but MUST stay tracked — do not add rules for them:
#   pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc, .nvmrc, .worktreeinclude,
#   next-env.d.ts, .env.example, commitlint.config.mjs, playwright.config.ts
#
# AI agents: section 7 ignores each tool's local setup out of the box, so there
# is nothing to configure per machine. Shared team agent config is deliberately
# NOT ignored (see the list at the top of section 7). If this repo later wants
# to commit a tool's config directory, drop that tool's blanket entry and keep
# only its "local state" lines.
###############################################################################


# =============================================================================
# 1. Dependencies & package managers
# =============================================================================

# --- Logs (covers npm/yarn/pnpm debug logs) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Diagnostic reports (https://nodejs.org/api/report.html) ---
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Coverage (tool-agnostic; see section 3 for test output) ---
lib-cov
coverage
*.lcov
.nyc_output

# --- Dependency directories ---
node_modules/
jspm_packages/
web_modules/

# --- Compiled binary addons ---
build/Release

# --- npm ---
.npm
*.tgz

# --- pnpm (this repo pins pnpm via corepack + packageManager) ---
.pnpm-store

# --- yarn v3 (only if the repo ever migrates off pnpm) ---
# .pnp.*
# .yarn/*
# !.yarn/patches
# !.yarn/plugins
# !.yarn/releases
# !.yarn/sdks
# !.yarn/versions
# .yarn-integrity


# =============================================================================
# 2. Next.js & build output
# =============================================================================

# Next.js build output (includes .next/types, .next/cache, .next/trace)
.next/
# Static export target (`next build` with output: 'export')
out/
# Turborepo / Nx caches, if ever adopted
# .turbo
# .nx

# Other bundler caches kept for parity with the upstream template
.cache/
.parcel-cache/
.temp


# =============================================================================
# 3. Testing (Playwright + Jest/Vitest if ever added)
# =============================================================================

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
trace.zip

# Jest / Vitest / Mocha output (harmless while unused)
.jest-cache/
jest.config.local.js
coverage-final.json


# =============================================================================
# 4. Lint, format & type caches
# =============================================================================

# TypeScript incremental-build cache (regenerated by tsc on every run)
*.tsbuildinfo
tsconfig.tsbuildinfo

# ESLint / Prettier / stylelint caches
.eslintcache
.stylelintcache

# Optional REPL history
.node_repl_history

# NOTE: next-env.d.ts is generated by Next.js but IS committed on purpose —
# it pins the generated route types for every contributor and in CI.


# =============================================================================
# 5. Environment variables, secrets & certificates
# =============================================================================

# dotenv / Next.js env files — everything except the committed example.
# This subsumes .env, .env.local, .env.*.local, .env.production, etc.
.env*
!.env.example

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# Keystores / credential caches produced by tooling
*.keystore
credentials.json
*_rsa
*_dsa
*_ed25519


# =============================================================================
# 6. Vercel
# =============================================================================

.vercel
.now


# =============================================================================
# 7. AI CODING AGENTS — local setups
# =============================================================================
# Every entry below is ACTIVE: cloning the repo on a new machine is already
# safe, no per-agent setup required. Entries are grouped per tool so a single
# tool can be removed or narrowed without touching the rest.
#
# These directories hold machine-local state — session transcripts, caches,
# credentials, absolute local paths, and occasionally tokens. They are noise
# in review and differ per developer, so they never belong in the repo.
#
# INTENTIONALLY NOT IGNORED (team-shared, commit these freely):
#   AGENTS.md            AGENTS.local.md       .mcp.json
#   CLAUDE.md            .claude/commands/     .claude/agents/
#   GEMINI.md            .cursorrules          .cursor/rules/
#   .aider.conf.yml      .github/copilot-instructions.md
#   .windsurfrules       .junie/guidelines.md  .specstory/README.md

# --- Claude Code (Anthropic) ---
# Blanket entry: the whole local setup is ignored. If this repo ever wants to
# commit shared Claude config, delete `.claude/` and keep only these:
#   .claude/settings.local.json
#   .claude/.credentials.json
#   .claude/backups/
#   .claude/history.jsonl
#   .claude/projects/
#   .claude/statsig/
#   .claude/todos/
#   .claude/__pycache__/
.claude/
CLAUDE.local.md

# --- gstack ---
.gstack/

# --- Cursor ---
.cursor/
# .cursorrules is shared config and stays tracked.

# --- Codex CLI (OpenAI) ---
.codex/

# --- Aider ---
# Matches .aider.chat.history.md, .aider.input.history, .aider.llm.history,
# .aider.tags.cache.v*/, .aider.env
.aider*
# ...but keep the shared config file itself tracked.
!.aider.conf.yml

# --- Gemini CLI (Google) ---
.gemini/

# --- Windsurf (Codeium) ---
.windsurf/

# --- Continue ---
.continue/

# --- Cline ---
.cline/

# --- Roo Code ---
.roo/

# --- Kiro (AWS) ---
.kiro/

# --- Amazon Q CLI ---
.amazonq/

# --- Qwen Code ---
.qwen/

# --- OpenCode ---
.opencode/

# --- Amp ---
.amp/

# --- Crush (Charm) ---
.crush/

# --- SpecStory (editor chat history) ---
.specstory/

# --- Junie (JetBrains AI) ---
# Guidelines are shared config; only local state is ignored.
.junie/cache/
.junie/history/

# --- GitHub Copilot CLI ---
# `copilot-debug.log` is already covered by `*.log` in section 1.
# `.github/copilot-instructions.md` stays tracked.
.copilot/

# --- Tool-agnostic local state ---
# Editor-style per-developer overrides for agent instructions
AGENTS.local.md
# Scratch/plan caches used by several agents
.agent-cache/
.agent/
# Prompt/eval fixtures dumped by agent tooling
.eval-cache/


# =============================================================================
# 8. Editors & IDEs
# =============================================================================

# --- Visual Studio Code ---
# Ignore the folder, then re-include the files that are meant to be shared.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
# local history
.vscode/.history/
# local history (older VS Code path)
.history/

# --- JetBrains (WebStorm / IntelliJ / Android Studio) ---
# `out/` is intentionally absent: it is already ignored in section 2 because
# Next.js writes its static export there, and IDE builds land there too.
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
# Gradle / Maven auto-import churn
.gradle/

# --- Vim / Neovim / Emacs ---
*.swp
*.swo
*~
.\#*
\#*\#
.\#*
*.[oa]
*.orig

# --- Sublime Text ---
*.sublime-workspace
*.sublime-project


# =============================================================================
# 9. Operating systems
# =============================================================================

# --- macOS (primary dev platform) ---
# General
.DS_Store
.AppleDouble
.LSOverride
Icon
.localized
__MACOSX/
# Resource forks
._*
# Directories potentially created on remote AFP shares
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
# Volume metadata
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.com.apple.timemachine.supported
.PKInstallSandboxManager
.PKInstallSandboxManager-SystemSoftware
.hotfiles.btree
.vol
.file
.disk_label*
# Legacy Mac OS
Desktop DB
Desktop DF
TheFindByContentFolder
TheVolumeSettingsFolder
.FBCIndex
.FBCSemaphoreFile
.FBCLockFolder
# Quota system
.quota.group
.quota.user
.quota.ops.group
.quota.ops.user
# Time Machine
Backups.backupdb
.MobileBackups
.MobileBackups.trash
MobileBackups.trash

# --- Linux ---
*~

# temporary files created while a deleted file still has an open handle
.fuse_hidden*
# metadata left by Dolphin file manager
.directory
# Linux trash folder
.Trash-*
# .nfs files
.nfs*
# noh.out
nohup.out
