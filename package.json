    "motion": "^12.43.0",
    "next": "^15.5.27",
    "posthog-js": "^1.435.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-social-media-embed": "^2.5.18",
    "tailwind-merge": "^3.7.0",
    "vgpu": "^0.5.0"
