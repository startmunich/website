# Copy this file to .env.local and fill in real values.
# See README.md → "Environment Variables" for setup details.
#
# Convention in this file:
#   uncommented  → required (something breaks without it)
#   commented    → optional (code handles its absence)

# --- Sanity (content source for startups, partners, network, news) ---
# The `production` dataset is public and read through the CDN, so no token is
# needed. These have defaults in `sanity/client.ts`; set them only to point at a
# different project. NEXT_PUBLIC_* values are inlined at build time, so changing
# one on Vercel requires a redeploy.
# NEXT_PUBLIC_SANITY_PROJECT_ID=j77hk8qc
# NEXT_PUBLIC_SANITY_DATASET=production

# --- NocoDB (waitlist submissions only) ---
# The waitlist is the last remaining NocoDB table. It was deliberately NOT moved
# to Sanity: it holds real applicant email addresses, and the Sanity `production`
# dataset is world-readable without authentication. Migrating it would publish
# every applicant's address. See docs/nocodb-migration.md.
# Account Settings → Tokens in NocoDB
NOCODB_API_TOKEN=
# Defaults to https://ndb.startmunich.de if unset
# NOCODB_BASE_URL=https://ndb.startmunich.de
# Table ID of the `Waitlist` table — visible in the NocoDB URL when it is open
NOCODB_WAITLIST_TABLE_ID=

# --- Cloudflare Turnstile (waitlist captcha) ---
# Dashboard → Turnstile → your site. Required for the waitlist API to accept
# submissions; missing values cause /api/waitlist to reject every request.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Luma (fallback event source) ---
# Only used when the members-platform events API is unreachable or unconfigured. Events normally
# come from my.startmunich.de, which syncs Luma itself — see "START Munich internal API" below.
# Luma → Calendar settings → API keys
LUMA_API_KEY=
# Restrict the fallback feed to one calendar. Omit to read every calendar the key can see.
# LUMA_CALENDAR_ID=
# Set to "1" to log per-request summaries (date range + event counts) for the Luma
# fallback. Off by default; errors are always logged via console.error.
# LUMA_DEBUG=

# --- START Munich internal API (my.startmunich.de) ---
# Used for member-batch detail, board data, and events. The key must carry the
# public:members:read, public:board:read and public:events:read scopes.
STARTMUNICH_API_KEY=
# Base URL for every members-platform call (board, members, events). Defaults to production;
# override to point at a local instance.
# MEMBERS_PLATFORM_API_URL=https://my.startmunich.de

# --- PostHog (analytics, optional) ---
# Project Settings → Project API Key. Omit to disable analytics in dev.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# --- Public site URL (optional) ---
# Used for absolute links, OG tags, etc. Vercel sets this automatically in
# production; set it for local dev only if you need absolute URLs.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
